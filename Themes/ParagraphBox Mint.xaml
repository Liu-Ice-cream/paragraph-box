<!-- Name: ParagraphBox Mint; IsDark: False; HasBlur: False -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" /></ResourceDictionary.MergedDictionaries>
  <system:Boolean x:Key="ThemeBlurEnabled">False</system:Boolean>
  <CornerRadius x:Key="ItemRadius">10</CornerRadius>
  <Thickness x:Key="ItemMargin">12 3 12 3</Thickness>
  <Thickness x:Key="ResultMargin">0 5 0 12</Thickness>
  <system:Double x:Key="ResultItemHeight">78</system:Double>
  <SolidColorBrush x:Key="ItemSelectedBackgroundColor" Color="#E5F0E5" />
  <Style x:Key="WindowRadius" TargetType="Border"><Setter Property="CornerRadius" Value="18" /></Style>
  <Style x:Key="WindowBorderStyle" BasedOn="{StaticResource BaseWindowBorderStyle}" TargetType="Border">
    <Setter Property="Background" Value="#FAFCF8" /><Setter Property="BorderBrush" Value="#DCE6D8" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="18" /><Setter Property="Padding" Value="4" />
  </Style>
  <Style x:Key="WindowStyle" BasedOn="{StaticResource BaseWindowStyle}" TargetType="Window" />
  <Style x:Key="QueryBoxStyle" BasedOn="{StaticResource BaseQueryBoxStyle}" TargetType="TextBox">
    <Setter Property="Foreground" Value="#234D37" /><Setter Property="CaretBrush" Value="#28664F" />
    <Setter Property="SelectionBrush" Value="#C5DFC9" /><Setter Property="Margin" Value="20 15 0 15" />
    <Setter Property="Height" Value="48" /><Setter Property="FontSize" Value="22" />
  </Style>
  <Style x:Key="QuerySuggestionBoxStyle" BasedOn="{StaticResource BaseQuerySuggestionBoxStyle}" TargetType="TextBox">
    <Setter Property="Foreground" Value="#A3B09B" /><Setter Property="Margin" Value="20 15 0 15" /><Setter Property="FontSize" Value="22" />
  </Style>
  <Style x:Key="ItemTitleStyle" BasedOn="{StaticResource BaseItemTitleStyle}" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#314F38" /><Setter Property="FontSize" Value="16" />
    <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="MaxHeight" Value="44" /><Setter Property="LineHeight" Value="22" />
  </Style>
  <Style x:Key="ItemTitleSelectedStyle" BasedOn="{StaticResource BaseItemTitleSelectedStyle}" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#214C31" /><Setter Property="FontSize" Value="16" />
    <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="MaxHeight" Value="44" /><Setter Property="LineHeight" Value="22" />
  </Style>
  <Style x:Key="ItemSubTitleStyle" BasedOn="{StaticResource BaseItemSubTitleStyle}" TargetType="TextBlock"><Setter Property="Foreground" Value="#8C9B83" /><Setter Property="FontSize" Value="12" /></Style>
  <Style x:Key="ItemSubTitleSelectedStyle" BasedOn="{StaticResource BaseItemSubTitleSelectedStyle}" TargetType="TextBlock"><Setter Property="Foreground" Value="#6C865F" /><Setter Property="FontSize" Value="12" /></Style>
  <Style x:Key="ItemGlyph" BasedOn="{StaticResource BaseGlyphStyle}" TargetType="TextBlock"><Setter Property="Foreground" Value="#719566" /></Style>
  <Style x:Key="ItemGlyphSelectedStyle" BasedOn="{StaticResource BaseGlyphSelectedStyle}" TargetType="TextBlock"><Setter Property="Foreground" Value="#467B49" /></Style>
  <Style x:Key="ImageIconStyle" TargetType="Image"><Setter Property="Height" Value="34" /><Setter Property="Width" Value="34" /></Style>
  <Style x:Key="ItemBulletSelectedStyle" BasedOn="{StaticResource BaseBulletStyle}" TargetType="Border"><Setter Property="Width" Value="3" /><Setter Property="Height" Value="36" /><Setter Property="CornerRadius" Value="2" /><Setter Property="Background" Value="#739A6C" /></Style>
  <Style x:Key="SeparatorStyle" BasedOn="{StaticResource BaseSeparatorStyle}" TargetType="Rectangle"><Setter Property="Height" Value="1" /><Setter Property="Fill" Value="#E3EBDD" /><Setter Property="Margin" Value="18 0 18 4" /></Style>
  <Style x:Key="PendingLineStyle" BasedOn="{StaticResource BasePendingLineStyle}" TargetType="Line"><Setter Property="Stroke" Value="#7FAA77" /></Style>
  <Style x:Key="SearchIconStyle" BasedOn="{StaticResource BaseSearchIconStyle}" TargetType="Path"><Setter Property="Fill" Value="#78936C" /><Setter Property="Height" Value="22" /><Setter Property="Width" Value="22" /></Style>
  <Style x:Key="ItemHotkeyStyle" BasedOn="{StaticResource BaseItemHotkeyStyle}" TargetType="TextBlock"><Setter Property="Foreground" Value="#8DA081" /><Setter Property="FontSize" Value="11" /></Style>
  <Style x:Key="ItemHotkeySelectedStyle" BasedOn="{StaticResource BaseItemHotkeySelectedStyle}" TargetType="TextBlock"><Setter Property="Foreground" Value="#6B8960" /><Setter Property="FontSize" Value="11" /></Style>
  <Style x:Key="ItemHotkeyBGStyle" BasedOn="{StaticResource BaseItemHotkeyBGStyle}" TargetType="Border"><Setter Property="Background" Value="#EDF3E6" /><Setter Property="CornerRadius" Value="6" /></Style>
  <Style x:Key="ItemHotkeyBGSelectedStyle" BasedOn="{StaticResource BaseItemHotkeyBGSelectedStyle}" TargetType="Border"><Setter Property="Background" Value="#D8E8CF" /><Setter Property="CornerRadius" Value="6" /></Style>
  <Style x:Key="PreviewBorderStyle" BasedOn="{StaticResource BasePreviewBorderStyle}" TargetType="Border"><Setter Property="BorderBrush" Value="#DEE8D7" /></Style>
  <Style x:Key="PreviewItemTitleStyle" BasedOn="{StaticResource BasePreviewItemTitleStyle}" TargetType="TextBlock"><Setter Property="Foreground" Value="#314F38" /></Style>
  <Style x:Key="PreviewItemSubTitleStyle" BasedOn="{StaticResource BasePreviewItemSubTitleStyle}" TargetType="TextBlock"><Setter Property="Foreground" Value="#8C9B83" /></Style>
  <Style x:Key="PreviewGlyph" BasedOn="{StaticResource BasePreviewGlyph}" TargetType="TextBlock"><Setter Property="Foreground" Value="#719566" /></Style>
  <Style x:Key="ClockBox" BasedOn="{StaticResource BaseClockBox}" TargetType="TextBlock"><Setter Property="Foreground" Value="#8DA081" /></Style>
  <Style x:Key="DateBox" BasedOn="{StaticResource BaseDateBox}" TargetType="TextBlock"><Setter Property="Foreground" Value="#8DA081" /></Style>
</ResourceDictionary>
